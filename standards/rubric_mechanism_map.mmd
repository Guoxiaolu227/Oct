flowchart LR
  ROOT[Weakness Review Standard v0.1]

  subgraph R1["R1 研究问题与贡献"]
    R1A["R1-1 问题未定义"]
    R1B["R1-2 贡献与方法不一致"]
    R1C["R1-3 创新性比较不足"]
    R1D["R1-4 重要性被夸大"]
    R1E["R1-5 比较范围不足"]
  end
  subgraph R2["R2 方法与假设有效性"]
    R2A["R2-1 隐含关键假设"]
    R2B["R2-2 假设被违反"]
    R2C["R2-3 方法与问题不匹配"]
    R2D["R2-4 描述相互矛盾"]
    R2E["R2-5 理论证明缺口"]
  end
  subgraph R3["R3 数据与实验设计"]
    R3A["R3-1 测试集泄漏"]
    R3B["R3-2 采样或划分偏差"]
    R3C["R3-3 基线不公平"]
    R3D["R3-4 指标不匹配"]
    R3E["R3-5 缺少控制实验"]
  end
  subgraph R4["R4 结果分析与结论"]
    R4A["R4-1 忽略不确定性"]
    R4B["R4-2 结论超出证据"]
    R4C["R4-3 相关当因果"]
    R4D["R4-4 选择性报告"]
    R4E["R4-5 局部结果泛化"]
  end
  subgraph R5["R5 透明度、复现与边界"]
    R5A["R5-1 数据来源不透明"]
    R5B["R5-2 预处理缺失"]
    R5C["R5-3 实现或超参数缺失"]
    R5D["R5-4 随机性与计算设置缺失"]
    R5E["R5-5 适用边界缺失"]
  end

  ROOT --> R1
  ROOT --> R2
  ROOT --> R3
  ROOT --> R4
  ROOT --> R5

  R1 --> R1A & R1B & R1C & R1D & R1E
  R2 --> R2A & R2B & R2C & R2D & R2E
  R3 --> R3A & R3B & R3C & R3D & R3E
  R4 --> R4A & R4B & R4C & R4D & R4E
  R5 --> R5A & R5B & R5C & R5D & R5E

  R3A -. "also affects" .-> R4B
  R3B -. "also affects" .-> R4E
  R3C -. "also affects" .-> R1E
  R5C -. "can affect" .-> R3A
  R5D -. "can affect" .-> R4A

  classDef root fill:#1f2937,color:#ffffff,stroke:#111827,stroke-width:2px;
  classDef rubric fill:#dbeafe,stroke:#2563eb,stroke-width:2px;
  classDef mechanism fill:#f3f4f6,stroke:#6b7280;
  class ROOT root;
  class R1,R2,R3,R4,R5 rubric;

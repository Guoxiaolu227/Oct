{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weakness-reviewer.local/schemas/mechanism_assessment.schema.json",
  "title": "MechanismAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "mechanism_ids", "status", "claim_under_review", "hypothesis", "causal_chain", "supporting_evidence", "counterevidence", "missing_information", "missingness_status", "resolution_needed", "severity", "verification"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "mechanism_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FM-R3-0[1-5]$"}},
    "status": {"enum": ["confirmed_flaw", "plausible_risk", "reporting_gap", "refuted", "not_applicable", "insufficient_evidence"]},
    "claim_under_review": {"type": "string"},
    "hypothesis": {"type": "string"},
    "causal_chain": {"type": "array", "items": {"type": "string"}},
    "supporting_evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "counterevidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "missing_information": {"type": "array", "items": {"type": "string"}},
    "missingness_status": {"enum": ["not_missing", "suspected_missing", "verified_missing"]},
    "resolution_needed": {"type": "array", "items": {"type": "string"}},
    "severity": {"type": "null"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_valid", "model_verdict", "reasons"],
      "properties": {
        "deterministic_valid": {"type": "boolean"},
        "model_verdict": {"enum": ["not_run", "accept", "downgrade", "reject"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
